{
  "manifest_version": 3,
  "name": "TranscriptGen — YouTube to Exam Notes",
  "version": "1.1.0",
  "description": "YouTube lecture transcript + AI exam study companion (notes, summaries, glossary, quiz, chat). Draggable floating window, zoom controls, zero-config.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "TranscriptGen",
    "default_popup": "popup.html"
  },
  "permissions": ["storage", "activeTab", "clipboardWrite"],
  "host_permissions": ["https://*/*", "http://localhost:*/*", "http://127.0.0.1:*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
